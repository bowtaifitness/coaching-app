# Bowtai Fitness - Environment Variables
# Copy this file to .env.development or .env.production and fill in values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Monthly Subscription Price ID
VITE_STRIPE_GOLF_SUBSCRIPTION_PRICE_ID=price_your-monthly-price-id
# Annual Subscription Price ID
VITE_STRIPE_GOLF_ANNUAL_PRICE_ID=price_your-annual-price-id

# Google OAuth (Web Client ID from Google Cloud Console)
VITE_GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Note: Server-side secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY,
# etc.) MUST NOT live in client .env files. Configure them as Supabase Edge Function
# secrets via the Supabase dashboard.
